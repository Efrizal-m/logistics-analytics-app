# --- Database ---------------------------------------------------------------
# App connects with a read-only role; the seed script uses the owner role.
POSTGRES_DB=logistics
POSTGRES_USER=logistics_owner
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Read-only role the API uses at runtime (created by seed.py)
READONLY_USER=logistics_ro
READONLY_PASSWORD=change-me-too

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# --- App --------------------------------------------------------------------
# Comma-separated. Must list the exact Vercel origin in production.
CORS_ORIGINS=http://localhost:5173
